# ============================================================================
# SUTRAWERKS ENTERPRISE .HTACCESS & ROUTING CONFIGURATION
# ============================================================================

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /sutrawerks/

# 1. Block access to sensitive files and dotfiles (.env, composer.json, git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(composer\.json|composer\.lock|\.env|README\.md)">
    Require all denied
</FilesMatch>

# 2. Custom Error Documents
ErrorDocument 403 /sutrawerks/403.php
ErrorDocument 404 /sutrawerks/404.php
ErrorDocument 500 /sutrawerks/500.php

# 3. Enforce HTTPS (uncomment when live on production server)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 4. Clean URL Routing Rules
# Skip rewriting for existing physical files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route clean URLs to underlying PHP scripts
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^industry-5-0/?$ industry-5-0.php [L]
RewriteRule ^agentic-ai/?$ agentic-ai.php [L]
RewriteRule ^zero-trust/?$ zero-trust.php [L]
RewriteRule ^platforms/?$ platforms.php [L]
RewriteRule ^consulting/?$ consulting.php [L]
RewriteRule ^case-studies/?$ case-studies.php [L]
RewriteRule ^insights/?$ insights.php [L]
RewriteRule ^about/?$ about.php [L]
RewriteRule ^privacy/?$ privacy.php [L]
RewriteRule ^terms/?$ terms.php [L]